# Copiar este archivo a .env y completar con valores reales antes de levantar el backend
# cp .env.example .env

# Base de datos PostgreSQL (si la configuración usa postgres en config.json)
POSTGRES_HOST=localhost
POSTGRES_USER=root
POSTGRES_PASSWORD=root
POSTGRES_DB=PA_FINAL
POSTGRES_PORT=5432

# Frontend (URL del backend)
VITE_FRONT_BACKEND=http://localhost:8000
